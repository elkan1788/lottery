generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LotteryPrize {
  id                String          @id
  name              String
  tier              Int
  probabilityWeight Int             @default(1) @map("probability_weight")
  stockTotal        Int             @default(0) @map("stock_total")
  stockRemaining    Int             @default(0) @map("stock_remaining")
  imageUrl          String?         @map("image_url")
  description       String?
  isActive          Boolean         @default(true) @map("is_active")
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  winners           LotteryWinner[]

  @@map("lottery_prizes")
  @@index([tier])
}

model LotteryWinner {
  id                String       @id
  nickname          String
  prizeId           String       @map("prize_id")
  prizeNameSnapshot String       @map("prize_name_snapshot")
  tierSnapshot      Int          @map("tier_snapshot")
  wonAt             DateTime     @default(now()) @map("won_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  prize             LotteryPrize @relation(fields: [prizeId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([prizeId])
  @@index([wonAt(sort: Desc)])
  @@map("lottery_winner")
}
